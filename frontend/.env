# URL del backend de CatalogoBulk. Toda variable visible desde el codigo debe
# empezar por VITE_ (asi lo exige Vite) y se lee con import.meta.env.VITE_API_URL.
VITE_API_URL=http://localhost:3000/api

# Nombre que se muestra en la barra superior y en la tarjeta de login.
VITE_APP_TITULO=CatalogoBulk
