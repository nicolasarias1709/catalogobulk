{
  "name": "catalogobulk",
  "version": "1.0.0",
  "description": "Sistema de importación masiva de productos con procesamiento asíncrono",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/workers/import.worker.js",
    "generar-catalogo": "node src/scripts/generar-catalogo.js",
    "test": "jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "setupFiles": [
      "<rootDir>/tests/jest.setup.js"
    ]
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bullmq": "^5.7.8",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  }
}
